DATABASE_URL=postgresql://eve_chats:eve_chats@127.0.0.1:55433/eve_chats
AUTH_SECRET=replace-with-local-dev-secret
EVELAND_PUBLIC_ORIGIN=http://localhost:17300
EVELAND_IDENTITY_RETURN_TARGET=eve-chats

# Only when Eveland preserves a pre-frontdoor Caller Token issuer:
# EVELAND_IDENTITY_ISSUER=http://localhost:4000
# Only when Dawn cannot reach EVELAND_PUBLIC_ORIGIN from the server/container:
# EVELAND_INTERNAL_ORIGIN=http://host.docker.internal:17300
# Optional; defaults to EVELAND_INTERNAL_ORIGIN + /.well-known/jwks.json:
# EVELAND_IDENTITY_JWKS_URL=http://host.docker.internal:17300/.well-known/jwks.json
